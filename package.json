{
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:auth": "tsx --test lib/auth-redirect.test.ts lib/access-policy.test.ts",
    "test:quality": "tsx --test lib/*.test.ts",
    "test:contract": "tsx --test lib/first-app-contract.test.ts",
    "test:first-session": "node --test scripts/verify-first-session.test.mjs",
    "verify:first-session": "node scripts/verify-first-session.mjs",
    "test:bootstrap": "bash tests/bootstrap-safety.sh && bash tests/bootstrap-destination.sh && bash tests/bootstrap-contract.sh && bash tests/bootstrap-desktop.sh && bash tests/bootstrap-postgres.sh && bash tests/bootstrap-docs.sh",
    "verify:template": "bash scripts/verify-template-release.sh",
    "verify": "npm run verify:template && npm run lint && npm run typecheck && npm run test:quality && prisma validate && npm run build && npm audit --omit=dev",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed:local": "NODE_ENV=development ALLOW_LOCAL_FIXTURES=true prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/fixtures/development.ts"
  },
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "@prisma/client": "6.12.0",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.2",
    "better-auth": "1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.26",
    "prisma": "6.12.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.0.0",
    "typescript": "^5"
  }
}
