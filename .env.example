# ═══════════════════════════════════════════════════════════════
# Better Auth (REQUIRED)
# ═══════════════════════════════════════════════════════════════

# Generate a unique value with: openssl rand -base64 32
# This is a server secret: never commit it or expose it with a NEXT_PUBLIC_ prefix.
BETTER_AUTH_SECRET=

# The base URL of your app (used by Better Auth for redirects and cookies)
BETTER_AUTH_URL=

# ═══════════════════════════════════════════════════════════════
# Database (REQUIRED)
# DATABASE_URL is the pooled runtime connection used by the app.
# DIRECT_URL is the direct, non-pooled connection used by Prisma Migrate.
# Keep both pointed at the same Neon database branch. Production values belong
# in Vercel environment variables, not this file.
#
# Get from: Neon console → your project → Connection Details
# Select "Prisma" from the framework dropdown to get both URLs.
# ═══════════════════════════════════════════════════════════════
DATABASE_URL=
DIRECT_URL=

# ═══════════════════════════════════════════════════════════════
# AI Features (OPTIONAL — add these when you need them)
# ═══════════════════════════════════════════════════════════════

# Replicate — image/video generation
# Get from: https://replicate.com/account/api-tokens
# REPLICATE_API_TOKEN=

# OpenAI — text generation, chat (if using Vercel AI SDK with OpenAI)
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Anthropic — text generation, chat (if using Vercel AI SDK with Anthropic)
# Get from: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# ═══════════════════════════════════════════════════════════════
# Payments & Email (OPTIONAL — add these when you need them)
# ═══════════════════════════════════════════════════════════════

# Stripe — payments, subscriptions
# Get from: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend — transactional email
# Get from: https://resend.com/api-keys
# RESEND_API_KEY=
