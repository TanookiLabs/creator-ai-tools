{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TanookiLabs/creator-ai-tools/blob/main/docs/contracts/first-app-receipt-v1.schema.json",
  "title": "First App Bootstrap Receipt v1",
  "type": "object",
  "required": ["contract_version", "kind", "run", "application", "provenance", "capabilities", "participant_actions", "result", "redaction", "timestamps"],
  "properties": {
    "contract_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "kind": { "const": "first_app_bootstrap_receipt" },
    "run": {
      "type": "object", "required": ["id", "sequence"],
      "properties": { "id": { "type": "string", "format": "uuid" }, "sequence": { "type": "integer", "minimum": 1 }, "rerun_of": { "type": "string", "format": "uuid" } },
      "additionalProperties": true
    },
    "application": {
      "type": "object", "required": ["root", "repository", "commit", "instructions"],
      "properties": {
        "root": { "type": "string", "pattern": "^/" }, "repository": { "$ref": "#/$defs/httpsRepository" }, "commit": { "$ref": "#/$defs/gitCommit" },
        "instructions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" } }
      }, "additionalProperties": true
    },
    "provenance": {
      "type": "object", "required": ["bootstrap", "template"],
      "properties": {
        "bootstrap": { "$ref": "#/$defs/bootstrapProvenance" },
        "template": { "$ref": "#/$defs/sourceProvenance" }
      }, "additionalProperties": true
    },
    "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
    "participant_actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "result": {
      "type": "object", "required": ["status", "failed_capability_ids"],
      "properties": { "status": { "enum": ["success", "partial_failure", "failed"] }, "failed_capability_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } },
      "additionalProperties": true
    },
    "redaction": {
      "type": "object", "required": ["applied", "fields"],
      "properties": { "applied": { "type": "boolean" }, "fields": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
      "additionalProperties": true
    },
    "timestamps": {
      "type": "object", "required": ["started_at", "finished_at"],
      "properties": { "started_at": { "$ref": "#/$defs/timestamp" }, "finished_at": { "$ref": "#/$defs/timestamp" } },
      "additionalProperties": true
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "httpsRepository": { "type": "string", "pattern": "^https://[^/?#@]+/[^/?#]+/[^/?#]+$" },
    "sourceProvenance": {
      "type": "object", "required": ["repository", "source_branch", "commit"],
      "properties": { "repository": { "$ref": "#/$defs/httpsRepository" }, "source_branch": { "const": "main" }, "commit": { "$ref": "#/$defs/gitCommit" }, "source_url": { "type": "string", "pattern": "^https://[^?#@]+$" } },
      "additionalProperties": true
    },
    "bootstrapProvenance": {
      "type": "object", "required": ["repository", "source_branch", "sha256"],
      "properties": { "repository": { "$ref": "#/$defs/httpsRepository" }, "source_branch": { "const": "main" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
      "additionalProperties": true
    },
    "capability": {
      "type": "object", "required": ["id", "status", "checked_at", "summary"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "status": { "enum": ["verified", "unverified", "unavailable", "failed", "skipped"] },
        "checked_at": { "$ref": "#/$defs/timestamp" }, "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
        "version": { "type": "string", "maxLength": 80 }, "evidence_code": { "$ref": "#/$defs/id" }, "recovery_action_id": { "$ref": "#/$defs/id" }
      }, "additionalProperties": true
    },
    "action": {
      "type": "object", "required": ["id", "kind", "blocking", "instruction"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["authenticate", "grant_permission", "confirm", "repair", "retry", "continue"] },
        "blocking": { "type": "boolean" }, "instruction": { "type": "string", "minLength": 1, "maxLength": 500 }
      }, "additionalProperties": true
    }
  },
  "additionalProperties": true
}
